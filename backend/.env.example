# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MQTT Broker Configuration (sesuai firmware config.c)
MQTT_HOST=your-mqtt-host.domain.com
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=hydro-backend-service
MQTT_BASE_TOPIC=hydroponik/unit01
MQTT_LEGACY_TOPICS=hidroponik/lab,polinela/lab

# InfluxDB Configuration
INFLUX_URL=http://localhost:9386
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=polinela
INFLUX_BUCKET=hydroponics

# SQLite Database File Path (relative to backend root)
SQLITE_DB_PATH=./data/hydro.db
