# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MQTT Broker Configuration (Polinela IoT Lab)
MQTT_HOST=sdp.polinela.ac.id
MQTT_PORT=1883
MQTT_USERNAME=septa
MQTT_PASSWORD=123321
MQTT_CLIENT_ID=hydro-backend-service
MQTT_BASE_TOPIC=hidroponik/lab
MQTT_RELAY_TOPIC=hidroponik/lab/relay

# InfluxDB Configuration
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=polinela
INFLUX_BUCKET=hydroponics

# SQLite Database File Path (relative to backend root)
SQLITE_DB_PATH=./data/hydro.db
