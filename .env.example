# ==============================================================================
# Portainer Stack Environment Variables Example
# Salin nilai ini ke tab 'Environment variables' di Portainer Stack
# ==============================================================================

# Port Mapping di Host Server (Unik, tidak tabrakan dengan port 80/8080/5000/8086 standar)
FRONTEND_PORT=9380
BACKEND_PORT=9350
INFLUX_PORT=9386

# MQTT Broker Configuration
MQTT_HOST=sdp.polinela.ac.id
MQTT_PORT=1883
MQTT_USERNAME=septa
MQTT_PASSWORD=123321
MQTT_CLIENT_ID=hydro-backend-service
MQTT_BASE_TOPIC=hidroponik/lab
MQTT_RELAY_TOPIC=hidroponik/lab/relay

# InfluxDB Configuration (Port host unik 9386. Kosongkan token jika menggunakan fallback SQLite)
INFLUX_URL=http://localhost:9386
INFLUX_TOKEN=
INFLUX_ORG=polinela
INFLUX_BUCKET=hydroponics
