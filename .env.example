# ==============================================================================
# Portainer Stack Environment Variables Example
# ==============================================================================

# Port Mapping di Host Server (Unik Blok 93xx)
FRONTEND_PORT=9380
BACKEND_PORT=9350
INFLUX_PORT=9386

# MQTT Broker Configuration (sesuai firmware config.c)
MQTT_HOST=sdp.polinela.ac.id
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=replace_with_mqtt_password
MQTT_CLIENT_ID=hydro-backend-service
MQTT_BASE_TOPIC=hydroponik/unit01
MQTT_LEGACY_TOPICS=hidroponik/lab,polinela/lab

# InfluxDB Configuration (Port 9386 - Tanpa memakai port 8086)
INFLUX_URL=http://influxdb:9386
INFLUX_TOKEN=replace_with_random_influx_token
INFLUX_ORG=polinela
INFLUX_BUCKET=hydroponics
INFLUX_USERNAME=admin
INFLUX_PASSWORD=replace_with_strong_influx_password

# Backend authentication (wajib diisi pada environment produksi)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password
AUTH_SECRET=replace_with_long_random_jwt_secret
